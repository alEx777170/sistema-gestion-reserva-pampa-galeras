# ===== Backend (Express + Oracle ADB) =====
# Copia este archivo a backend/.env y completa los valores.

# Servidor
PORT=4000

# Conexión a Oracle Autonomous Database (ADB) en la nube (OCI - us-ashburn-1)
# El wallet (tnsnames.ora, cwallet.sso, ...) está en backend/wallet/
# Usuario ADMIN de la ADB (solo lo usa setup_adb.js para crear los usuarios)
ORACLE_ADMIN_USER=ADMIN
ORACLE_ADMIN_PASSWORD=contrasena_del_admin_de_la_adb

# Esquema de la aplicación (lo crea setup_adb.js)
ORACLE_USER=admin_rnpg
ORACLE_PASSWORD=AdminRNPG_2025*
# Alias TNS del servicio ADB (high = mayor rendimiento para OLTP)
ORACLE_CONNECT_STRING=vkczdham6nyr8ljv_high
# Directorio del wallet (relativo a backend/)
TNS_ADMIN=./wallet
# Oracle Instant Client: la ADB rechaza el modo thin (ORA-12506), así que la
# app corre en modo thick. Apunta a la carpeta descomprimida de Instant Client
# (https://www.oracle.com/database/technologies/instant-client/downloads.html).
# Si lo dejas vacío, se usa el modo thin (solo sirve para bases locales).
ORACLE_IC_HOME=C:\Users\TUCUARIO\oracle\instantclient_23_0

# Acceso al panel de administración de la app
ADMIN_USER=admin
ADMIN_PASS=admin123

# Clave para firmar los tokens de sesión (mínimo 16 caracteres)
JWT_SECRET=pampa_galeras_secreto_2025

# Consola SQL del panel admin (true/false)
ALLOW_EXECUTE=false
# Script SQL que se ejecuta desde la consola
SQL_FILE_PATH=../proyecto_adb.sql
