# Configuración del servidor
PORT=4000

# Conexión a Oracle Database (usuario dueño de las tablas)
ORACLE_USER=admin_rnpg
ORACLE_PASSWORD=tu_contraseña
ORACLE_CONNECT_STRING=localhost:1521/XEPDB1

# Acceso al panel de administración (obligatorios)
ADMIN_USER=admin
ADMIN_PASS=cambia_esta_clave
# Clave para firmar los tokens de sesión: texto largo y aleatorio (mínimo 16 caracteres)
JWT_SECRET=cambia_esto_por_un_texto_largo_y_aleatorio

# Consola SQL del panel Admin: déjala en false salvo en tu máquina de desarrollo
ALLOW_EXECUTE=false
